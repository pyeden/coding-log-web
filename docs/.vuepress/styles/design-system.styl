// ============================================================
// 全站视觉系统：深色科技风（Dark Cyber / Blueprint）
// 网格只有一个 owner：body::before（固定视口层）
// 页面壳透明，面板/卡片用 token 控制透明度
// ============================================================

html
  background: var(--bodyBg)
  scroll-behavior: smooth

body
  position: relative
  margin: 0
  padding: 0
  font-family: "Inter", "SF Pro Text", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif
  font-size: 16px
  line-height: 1.7
  color: var(--textColor)
  background-color: var(--bodyBg)
  background-image: radial-gradient(900px 600px at 12% -10%, var(--site-glow), transparent 60%), radial-gradient(760px 520px at 88% 10%, var(--site-glow-2), transparent 58%)
  background-attachment: fixed
  background-repeat: no-repeat
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale

// 唯一的全站网格层
body::before
  content: ''
  position: fixed
  inset: 0
  z-index: 0
  pointer-events: none
  background-image: linear-gradient(to right, var(--site-grid) 1px, transparent 1px), linear-gradient(to bottom, var(--site-grid) 1px, transparent 1px)
  background-size: 48px 48px
  background-position: 0 0
  background-repeat: repeat

html body .theme-container
  position: relative
  z-index: 1
  min-height: 100vh
  background-color: transparent
  overflow-x: clip
  color: var(--textColor)

// 页面壳只负责布局，不负责绘制背景
html body .theme-container .page,
html body .custom-page,
html body .home-wrapper,
html body .home-wrapper .main-wrapper,
html body .main-wrapper,
html body .main-wrapper .main-left,
html body .main-wrapper .main-right,
html body .theme-vdoing-wrapper,
html body .theme-vdoing-wrapper .content-wrapper,
html body .footer
  background-color: transparent

// 文章 / 目录 / 关于 / 旅行助手 / 归档的大面板
html body .theme-container .theme-vdoing-wrapper
  background-color: var(--site-panel)
  background-image: none
  border-radius: 14px
  box-shadow: inset 0 0 0 1px var(--site-border), 0 18px 48px var(--site-shadow)

// ---------- 导航与侧栏 ----------
html body .navbar
  background-color: var(--site-chrome)
  border-bottom: 1px solid var(--site-border)
  box-shadow: 0 10px 30px var(--site-shadow)
  backdrop-filter: blur(18px) saturate(160%)
  -webkit-backdrop-filter: blur(18px) saturate(160%)
  .home-link
    .logo
      width: 28px
      height: 28px
      border-radius: 8px
      box-shadow: 0 0 0 1px var(--site-border), 0 0 18px var(--site-glow)
    .site-name
      color: var(--site-text)
      font-weight: 700
      letter-spacing: -.02em
  .links
    background: transparent
    a
      color: var(--site-text)
      opacity: .74
      font-weight: 500
      transition: color .2s ease, opacity .2s ease
      &:hover, &.active
        color: var(--site-accent-text)
        opacity: 1
  .nav-dropdown
    background-color: var(--site-surface)
    border: 1px solid var(--site-border)
    border-radius: 10px
    box-shadow: 0 18px 40px var(--site-shadow)
    a
      color: var(--site-text)
      &:hover
        color: var(--site-accent-text)

html body .sidebar
  background-color: var(--site-chrome)
  border-right: 1px solid var(--site-border)
  padding: .75rem .6rem 2rem
  .blogger
    padding: .6rem .55rem 1rem
    border-bottom: 1px solid var(--site-border)
    margin-bottom: .6rem
    .blogger-info .name
      color: var(--site-text)
      font-weight: 650
  .sidebar-links
    padding: .3rem 0
  a
    color: var(--site-text)
    border-radius: 8px
    transition: color .2s ease, background .2s ease
    &:hover
      color: var(--site-accent-text)
      background-color: var(--site-glow)
  .sidebar-heading
    color: var(--site-muted)
    font-size: .72rem
    letter-spacing: .1em
    text-transform: uppercase
  .active > a, a.active, .sidebar-link.active
    color: var(--site-accent-text)
    background-image: linear-gradient(90deg, var(--site-glow), transparent)
  .sidebar-sub-headers
    border-left: 1px solid var(--site-border)

body .search-box input
  background-color: var(--site-surface)
  border: 1px solid var(--site-border)
  border-radius: 10px
  color: var(--site-text)
  &:focus
    border-color: var(--site-accent)
    box-shadow: 0 0 0 3px var(--site-glow)

// ---------- 卡片 ----------
html body .theme-container .card-box,
html body .theme-container .post,
html body .theme-container .right-menu-title,
html body .theme-container .right-menu-content
  background-color: var(--site-card)
  border: 1px solid var(--site-border)
  border-radius: 14px
  box-shadow: 0 12px 32px var(--site-shadow)
  transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease

html body .theme-container .card-box:hover,
html body .theme-container .post:hover
  border-color: rgba(34,211,238,.28)
  box-shadow: 0 18px 48px var(--site-shadow)

// ---------- 排版 ----------
.theme-vdoing-content
  font-size: 16px
  line-height: 1.88
  color: var(--site-text)
  h1, h2, h3, h4, h5, h6
    color: var(--site-text)
    letter-spacing: -.02em
  h1
    font-size: 2.15rem
  h2
    margin-top: 2.4rem
    padding: .25rem 0 .25rem .85rem
    border-bottom: none
    border-left: 3px solid var(--site-accent)
    border-radius: 4px
    background-image: linear-gradient(90deg, var(--site-glow), transparent)
  h3
    margin-top: 2rem
  p
    line-height: 1.9
  a
    color: var(--site-accent-text)
    text-decoration: none
    border-bottom: 1px solid transparent
    transition: border-color .2s ease
    &:hover
      border-bottom-color: var(--site-accent-text)
  blockquote
    margin: 1.4rem 0
    padding: .85rem 1.1rem
    background-color: var(--site-glow)
    border-left: 3px solid var(--site-accent)
    border-radius: 0 10px 10px 0
    color: var(--site-text)
    opacity: 1
    > p
      margin: 0
  hr
    border-top: 1px solid var(--site-border)
  table
    border: 1px solid var(--site-border)
    border-radius: 10px
    overflow: hidden
    display: table
    width: 100%
    th
      background-color: var(--site-elevated)
      color: var(--site-text)
    tr
      border-top: 1px solid var(--site-border)
      &:nth-child(2n)
        background-color: rgba(255,255,255,.025)
    th, td
      border: 1px solid var(--site-border)
  code
    background-color: rgba(34,211,238,.08)
    border-radius: 5px
    padding: .1rem .35rem
    color: var(--site-accent-text)
  pre
    border: 1px solid var(--site-border)
    border-radius: 12px
    background-color: var(--codeBg)
    code
      background-color: transparent
      padding: 0
      color: inherit
  div[class*="language-"]
    border: 1px solid var(--site-border)
    border-radius: 12px
    background-color: var(--codeBg)
    box-shadow: 0 10px 28px var(--site-shadow)
    pre
      border: none
      border-radius: 0
      background-color: transparent
  img
    border-radius: 10px

.theme-vdoing-content .chapter-figure
  img
    border-radius: 10px
    border: 1px solid var(--site-border)
    box-shadow: 0 18px 40px var(--site-shadow)
  figcaption
    color: var(--site-muted)

.custom-block
  border: 1px solid var(--site-border)
  border-radius: 10px
  background-color: var(--customBlockBg)
  &.tip
    border-color: rgba(34,211,238,.35)
    background-color: rgba(34,211,238,.07)
  &.warning
    border-color: rgba(245,158,11,.35)
  &.danger
    border-color: rgba(244,63,94,.35)

// ---------- 首页 ----------
html body .home-wrapper .banner
  margin-top: 3.6rem
  min-height: 500px
  background-color: transparent
  background-image: radial-gradient(700px circle at 12% 18%, var(--site-glow), transparent 55%), radial-gradient(620px circle at 88% 8%, var(--site-glow-2), transparent 52%), linear-gradient(180deg, var(--site-hero-veil), transparent 88%)
  border-bottom: 1px solid var(--site-border)
  .banner-conent
    position: relative
    z-index: 1
  .hero
    h1
      font-size: clamp(2.6rem, 5.5vw, 4rem)
      color: #f8fafc
      text-shadow: 0 0 40px var(--site-glow)
    .description
      color: var(--site-muted)
      opacity: 1
    .action-button
      border: 1px solid rgba(34,211,238,.35)
      border-radius: 10px
      background-color: var(--site-accent)
      box-shadow: 0 10px 30px var(--site-glow)
  .features
    gap: 1rem
  .feature
    flex: 1 1 30%
    max-width: 31%
    padding: 1.4rem 1rem
    background-color: var(--site-card)
    border: 1px solid var(--site-border)
    border-radius: 16px
    transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease
    &:hover
      transform: translateY(-4px)
      border-color: rgba(34,211,238,.35)
      box-shadow: 0 18px 44px var(--site-shadow)
    .feature-img
      width: 7rem
      height: 7rem
      filter: drop-shadow(0 0 18px var(--site-glow))
    h2
      font-size: 1.15rem
      color: var(--site-text)
    p
      color: var(--site-muted)
      opacity: 1

html body .home-wrapper .banner::before
  content: none

// ---------- 项目页 ----------
html body .theme-container .ps
  background-color: transparent
  background-image: none
  border-bottom: 1px solid var(--site-border)

html body .theme-container .ps .ps-grid
  display: none

// ---------- 页脚 ----------
html body .footer
  border-top: 1px solid var(--site-border)
  background-color: transparent
  color: var(--site-muted)
  a
    color: var(--site-accent-text)

// ---------- 响应式 ----------
@media (max-width: 719px)
  html body .theme-container .theme-vdoing-wrapper
    border-radius: 0
  html body .home-wrapper .banner
    min-height: 420px
    .hero h1
      font-size: 2.3rem
  html body .home-wrapper .feature
    max-width: 100%

@media print
  body::before
    display: none
  body
    background: #fff
    color: #111

// ============================================================
// V2：AI 科技炫酷风（不是方格子蓝图）
// 以极光渐变、玻璃卡片、霓虹描边和渐变标题为主
// ============================================================

@media screen
  body
    background-color: #04070f
    background-image: radial-gradient(900px 600px at 10% -10%, rgba(34,211,238,.22), transparent 60%), radial-gradient(800px 560px at 92% 6%, rgba(139,92,246,.20), transparent 60%), radial-gradient(760px 520px at 52% 112%, rgba(244,114,182,.10), transparent 65%)
    background-attachment: fixed
    background-repeat: no-repeat

  // 极细点阵，替代方格子
  body::before
    background-image: radial-gradient(circle at 1px 1px, rgba(148,163,184,.16) 1px, transparent 0)
    background-size: 26px 26px
    background-position: 0 0
    background-repeat: repeat
    mask-image: linear-gradient(to bottom, rgba(0,0,0,.85), transparent 92%)
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,.85), transparent 92%)

  // 导航：底部霓虹线 + 品牌渐变字
  html body .navbar
    background-image: linear-gradient(90deg, rgba(34,211,238,.08), transparent 42%, rgba(139,92,246,.07))
    box-shadow: 0 12px 40px rgba(0,0,0,.35), inset 0 -1px 0 rgba(34,211,238,.20)
    .site-name
      background-image: linear-gradient(100deg, #f8fafc, #67e8f9 55%, #c4b5fd)
      -webkit-background-clip: text
      background-clip: text
      color: transparent
      -webkit-text-fill-color: transparent

  // 侧栏当前项：左侧霓虹条
  html body .sidebar .active > a,
  html body .sidebar a.active,
  html body .sidebar .sidebar-link.active
    background-image: linear-gradient(90deg, rgba(34,211,238,.18), transparent)
    box-shadow: inset 2px 0 0 #22d3ee

  // 文章面板：顶部高光
  html body .theme-container .theme-vdoing-wrapper
    box-shadow: inset 0 1px 0 rgba(34,211,238,.30), 0 18px 48px var(--site-shadow)

  // 卡片：玻璃 + 霓虹描边 + 悬浮光晕
  html body .theme-container .card-box,
  html body .theme-container .post
    border-color: rgba(34,211,238,.16)
    box-shadow: inset 0 1px 0 rgba(255,255,255,.045), 0 18px 40px var(--site-shadow)

  html body .theme-container .card-box:hover,
  html body .theme-container .post:hover
    border-color: rgba(34,211,238,.48)
    box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 22px 60px rgba(0,0,0,.42), 0 0 40px rgba(34,211,238,.10)

  // 首页 Hero：渐变标题 + 科技标签
  html body .home-wrapper .banner .hero::before
    content: 'AI · ENGINEERING · NOTES'
    display: inline-block
    margin-bottom: .9rem
    padding: .28rem .75rem
    border: 1px solid rgba(34,211,238,.32)
    border-radius: 999px
    background: rgba(34,211,238,.06)
    color: #67e8f9
    font-size: .66rem
    letter-spacing: .18em
    font-weight: 600

  html body .home-wrapper .banner .hero h1
    background-image: linear-gradient(110deg, #f8fafc 0%, #67e8f9 38%, #c4b5fd 70%, #f9a8d4 100%)
    -webkit-background-clip: text
    background-clip: text
    color: transparent
    -webkit-text-fill-color: transparent
    text-shadow: none

  html body .home-wrapper .banner .feature
    background-color: rgba(11,20,35,.72)
    border-color: rgba(34,211,238,.18)
    box-shadow: inset 0 1px 0 rgba(255,255,255,.05), 0 18px 40px rgba(0,0,0,.28)
    &:hover
      border-color: rgba(34,211,238,.5)
      box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 22px 55px rgba(0,0,0,.38), 0 0 45px rgba(34,211,238,.10)

  // 文章标题：渐变下划线，不再用整块底色
  .theme-vdoing-content h2
    padding-left: 0
    padding-bottom: .55rem
    border-left: 0
    background-image: none
    position: relative

  .theme-vdoing-content h2::after
    content: ''
    display: block
    width: 64px
    height: 3px
    margin-top: .55rem
    border-radius: 999px
    background-image: linear-gradient(90deg, #22d3ee, #8b5cf6 60%, #f472b6)

  .theme-vdoing-content blockquote
    background-image: linear-gradient(135deg, rgba(34,211,238,.10), rgba(139,92,246,.06))

  .theme-vdoing-content div[class*="language-"]
    border-color: rgba(34,211,238,.18)
    box-shadow: inset 0 1px 0 rgba(34,211,238,.12), 0 14px 36px rgba(0,0,0,.28)

  // 项目页：让极光背景透出来
  html body .theme-container .ps
    background-color: transparent
    background-image: none
