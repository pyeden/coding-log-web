//***vdoing 主题变量覆盖：统一深色科技风***//

$accentColor = #22d3ee
$activeColor = #8b5cf6
$bannerTextColor = #e6f7ff
$arrowBgColor = #64748b

// 布局
$navbarHeight = 3.6rem
$sidebarWidth = 17rem
$contentWidth = 880px
$homePageWidth = 1120px
$rightMenuWidth = 230px
$lineNumbersWrapperWidth = 2.5rem

// 浅色模式（保留可切换）
.theme-mode-light
  --bodyBg: #f6f8fc
  --mainBg: #ffffff
  --sidebarBg: rgba(255,255,255,.92)
  --blurBg: rgba(255,255,255,.86)
  --customBlockBg: #f8fafc
  --textColor: #111827
  --textLightenColor: #0284c7
  --borderColor: rgba(15,23,42,.08)
  --codeBg: #f6f8fb
  --codeColor: #334155
  codeThemeLight()

// 深色模式（默认）
.theme-mode-dark
  --bodyBg: #060b16
  --mainBg: #0b1423
  --sidebarBg: rgba(8,16,29,.94)
  --blurBg: rgba(6,11,22,.84)
  --customBlockBg: #0e1a2b
  --textColor: #dbe7f3
  --textLightenColor: #67e8f9
  --borderColor: rgba(120,160,200,.16)
  --codeBg: #070f1b
  --codeColor: #dbe7f3
  codeThemeDark()

// 阅读模式
.theme-mode-read
  --bodyBg: #14120d
  --mainBg: #1a1711
  --sidebarBg: rgba(26,23,17,.94)
  --blurBg: rgba(20,18,13,.86)
  --customBlockBg: #211d16
  --textColor: #e8dcc4
  --textLightenColor: #d6b36a
  --borderColor: rgba(214,179,106,.18)
  --codeBg: #12100b
  --codeColor: #e8dcc4
  codeThemeDark()
