<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.openclaw.codinglogweb.dev</string>
  <key>UserName</key><string>mac</string>
  <key>GroupName</key><string>staff</string>
  <key>WorkingDirectory</key><string>/Users/mac/coding-log-web</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/mac</string>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin; cd /Users/mac/coding-log-web; while true; do /usr/local/bin/npm run dev &gt;&gt; output.log 2&gt;&amp;1; sleep 5; done</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
</dict>
</plist>
